# Public Google OAuth Client ID (safe to expose in frontend code/bundles).
# Get this from Google Cloud Console > APIs & Services > Credentials.
VITE_GOOGLE_CLIENT_ID=

# Optional: Google Books API key, used for higher-quality book cover art.
# Falls back to Open Library (no key needed) if left blank.
# Get this from Google Cloud Console > APIs & Services > Credentials > Create Credentials > API Key,
# after enabling the "Books API" under APIs & Services > Library.
# Restrict it: Application restrictions > HTTP referrers (add localhost:5173/* for dev),
# and API restrictions > restrict key to "Books API" only.
VITE_GOOGLE_BOOKS_API_KEY=
